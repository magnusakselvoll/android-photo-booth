<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MagnusAkselvoll.AndroidPhotoBooth.Tests</RootNamespace>
    <AssemblyName>android-photo-booth-app.tests</AssemblyName>
    <IsTestProject>true</IsTestProject>

    <!-- Code Quality & Modern Constructs -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Build Configuration -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Versioning -->
    <Version>2.0.0</Version>
    <InformationalVersion>2.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\android-photo-booth-app\android-photo-booth-app.csproj" />
  </ItemGroup>

</Project>