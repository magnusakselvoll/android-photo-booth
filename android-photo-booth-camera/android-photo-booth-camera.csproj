<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MagnusAkselvoll.AndroidPhotoBooth.Camera</RootNamespace>
    <AssemblyName>android-photo-booth-camera</AssemblyName>

    <!-- Code Quality & Modern Constructs -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Build Configuration -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Versioning -->
    <Version>2.0.0</Version>
    <InformationalVersion>2.0.0</InformationalVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <ProductVersion>2.0.0.0</ProductVersion>

    <!-- Metadata -->
    <Company>Magnus Akselvoll</Company>
    <Product>Android Photo Booth</Product>
    <Description>Camera control library for Android Photo Booth</Description>
    <PackageProjectUrl>https://github.com/magnusakselvoll/android-photo-booth</PackageProjectUrl>
    <RepositoryUrl>https://github.com/magnusakselvoll/android-photo-booth</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>

</Project>