<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MagnusAkselvoll.AndroidPhotoBooth.App</RootNamespace>
    <AssemblyName>android-photo-booth-app</AssemblyName>

    <!-- Code Quality & Modern Constructs -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Build Configuration -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Versioning -->
    <Version>2.0.0</Version>
    <InformationalVersion>2.0.0</InformationalVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <ProductVersion>2.0.0.0</ProductVersion>

    <!-- Metadata -->
    <Company>Magnus Akselvoll</Company>
    <Product>Android Photo Booth</Product>
    <Description>Windows Forms application for managing photo booths with Android devices</Description>
    <PackageProjectUrl>https://github.com/magnusakselvoll/android-photo-booth</PackageProjectUrl>
    <RepositoryUrl>https://github.com/magnusakselvoll/android-photo-booth</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\android-photo-booth-camera\android-photo-booth-camera.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>